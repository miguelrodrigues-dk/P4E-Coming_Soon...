<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tabela de Usuários | P4E</title>
  <link rel="stylesheet" href="/css/e-ventus.css">
  <style>
   
    .admin-bg {
      background: radial-gradient(circle at top, #1e1233 0%, #0c0814 100%);
      min-height: 100vh;
      padding-bottom: 60px;
    }

    .admin-container {
      max-width: 1040px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .glass-card {
      background: rgba(25, 18, 41, 0.65);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      padding: 40px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .admin-header {
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 25px;
      margin-bottom: 30px;
    }

    .admin-header h1 {
      font-size: 2.5rem;
      margin: 0 0 10px 0;
      background: linear-gradient(135deg, #fff 30%, #a855f7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -1px;
    }

    .admin-header p {
      color: #94a3b8;
      margin: 0;
      font-size: 1.1rem;
    }

    /* Tabela Customizada Fluida */
    .tabela-wrapper {
      overflow-x: auto;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .tabela-usuarios {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      background: rgba(12, 8, 20, 0.4);
    }

    .tabela-usuarios th {
      background-color: rgba(168, 85, 247, 0.1);
      color: #c084fc;
      padding: 16px 20px;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 1px;
      border-bottom: 2px solid rgba(168, 85, 247, 0.2);
    }

    .tabela-usuarios td {
      padding: 18px 20px;
      color: #e2e8f0;
      font-size: 0.95rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      transition: all 0.2s ease;
    }

    .tabela-usuarios tr:last-child td {
      border-bottom: none;
    }

    .tabela-usuarios tr:hover td {
      background: rgba(168, 85, 247, 0.04);
      color: #fff;
    }

    .user-id {
      color: #a855f7;
      font-family: monospace;
      font-size: 1rem;
    }

    .user-nome {
      font-weight: 600;
    }

    .user-email {
      color: #94a3b8;
    }

    /* Badges Neon Estilizados */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 99px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-admin {
      background: rgba(234, 179, 8, 0.15);
      color: #facc15;
      border: 1px solid rgba(234, 179, 8, 0.3);
      box-shadow: 0 0 12px rgba(234, 179, 8, 0.1);
    }

    .badge-comum {
      background: rgba(168, 85, 247, 0.15);
      color: #c084fc;
      border: 1px solid rgba(168, 85, 247, 0.3);
    }
  </style>
</head>
<body>

<div class="admin-bg">
  <%- include('../partials/nav') %>

  <main class="admin-container">
    <div class="glass-card">
      
      <header class="admin-header">
        <h1>Tabela de Usuários</h1>
        <p>Gerenciador de usuarios.</p>
      </header>

      <div class="tabela-wrapper">
        <table class="tabela-usuarios">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nome Completo</th>
              <th>E-mail de Acesso</th>
              <th>Nível de Permissão</th>
            </tr>
          </thead>
          <tbody>
            <% listaUsuarios.forEach(user => { %>
              <tr>
                <td><span class="user-id">#<%= user.id %></span></td>
                <td><span class="user-nome"><%= user.nome %></span></td>
                <td><span class="user-email"><%= user.email %></span></td>
                <td>
                  <% if (user.role === 'admin') { %>
                    <span class="badge badge-admin"><%= user.role %></span>
                  <% } else { %>
                    <span class="badge badge-comum">👤 <%= user.role %></span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>
