<%- include('../partials/header', { titulo: 'Editar evento | P4E' }) %>

<main class="container pagina-detalhes">
  <a class="link-voltar" href="/eventos/<%= evento.id %>">← Voltar aos detalhes</a>

  <section class="form-comentario form-novo-evento">
    <h1>Editar evento</h1>
    <p class="descricao-formulario">
      Atualize as informações abaixo para modificar os dados do evento no P4E.
    </p>

    <form action="/eventos/<%= evento.id %>/editar" method="POST">

      <label for="nome">Nome do evento</label>
      <input
        id="nome"
        name="nome"
        type="text"
        maxlength="100"
        value="<%= evento.nome %>"
        required
      >

      <label for="categoria">Categoria</label>
      <select id="categoria" name="categoria" required>
        <option value="">Selecione uma categoria</option>
        <% ['Música', 'Social', 'Cultura', 'Tecnologia', 'Esportes', 'Educação', 'Outro'].forEach(cat => { %>
          <option value="<%= cat %>" <%= evento.categoria === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>

      <label for="data">Data do evento</label>
      <input
        id="data"
        name="data"
        type="text"
        placeholder="DD/MM/AAAA"
        pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}"
        title="Informe a data no formato DD/MM/AAAA"
        value="<%= evento.data %>"
        required
      >

      <label for="local">Local</label>
      <input
        id="local"
        name="local"
        type="text"
        maxlength="150"
        value="<%= evento.local %>"
        required
      >

      <label for="descricao">Descrição</label>
      <textarea
        id="descricao"
        name="descricao"
        rows="5"
        maxlength="1500"
        required
      ><%= evento.descricao %></textarea>

      <div class="opcao-destaque">
        <label class="checkbox-destaque" for="destaque">
          <input
            id="destaque"
            name="destaque"
            type="checkbox"
            <%= evento.destaque ? 'checked' : '' %>
          >
          <span>Destacar este evento no carrossel</span>
        </label>

        <p>
          Marque esta opção somente se quiser exibir o evento no banner
          principal da página inicial.
        </p>
      </div>

      <div id="campo-imagem" <%= evento.destaque ? '' : 'hidden' %>>
        <label for="imagem">URL da imagem de destaque</label>
        <input
          id="imagem"
          name="imagem"
          type="url"
          value="<%= evento.imagem %>"
          placeholder="https://exemplo.com"
        >
        <p class="ajuda-imagem">
          A imagem será utilizada somente no carrossel.
        </p>
      </div>

      <div class="acoes-formulario">
        <button class="botao" type="submit">
          Salvar alterações
        </button>

        <a class="link-voltar" href="/eventos/<%= evento.id %>">
          Cancelar
        </a>
      </div>

    </form>
  </section>
</main>

<script>
  const checkboxDestaque = document.getElementById('destaque');
  const campoImagem = document.getElementById('campo-imagem');
  const inputImagem = document.getElementById('imagem');

  function atualizarCampoImagem() {
    campoImagem.hidden = !checkboxDestaque.checked;
    inputImagem.required = checkboxDestaque.checked;

    if (!checkboxDestaque.checked) {
      inputImagem.value = '';
    }
  }

  checkboxDestaque.addEventListener('change', atualizarCampoImagem);

  // Executa uma vez ao carregar a página para definir o estado inicial correto
  atualizarCampoImagem();
</script>

<%- include('../partials/footer') %>
