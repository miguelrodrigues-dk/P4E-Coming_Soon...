<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/e-ventus.css">
  <title>Criar Conta - P4E</title>
</head>
<body>

  <!-- Inclui o seu cabeçalho com o logotipo -->
 <%- include('../partials/header', { titulo: 'Criar conta | P4E' }) %>

  <main class="container-cadastro">
    <div class="card-cadastro">
      <h2>Criar Nova Conta</h2>
      <p class="subtitulo-cadastro">Faça seu cadstro com a P4E e venha curtir conosco</p>

     
      <form action="/eventos/cadastro" method="POST" class="form-cadastro">
        
        <div class="grupo-campo">
          <label for="nome">Nome Completo</label>
          <input type="text" id="nome" name="nome" placeholder="Digite seu nome" required>
        </div>

        <div class="grupo-campo">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" placeholder="seu@email.com" required>
        </div>

        <div class="grupo-campo">
          <label for="senha">Senha</label>
          <input type="password" id="senha" name="senha" placeholder="Crie uma senha segura" required>
        </div>

        <button type="submit" class="botao botao-largo">Finalizar Cadastro</button>
      </form>

      <div class="rodape-card">
        <span>Já tem uma conta? <a href="/eventos/login">Faça login</a></span>
      </div>
    </div>
  </main>

  <!-- Inclui o seu rodapé padrão -->
<%- include('../partials/footer') %>

